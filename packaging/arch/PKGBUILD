# Maintainer: Floe project contributors
pkgname=floe
pkgver=0.1.0
pkgrel=1
pkgdesc='Spatial file manager for Wayland'
arch=('x86_64')
url='https://github.com/rodriguezcappsec/floe'
license=('LicenseRef-proprietary')
depends=('gtk4>=4.14' 'libadwaita>=1.5' 'glib2' 'hicolor-icon-theme')
makedepends=('rust' 'pkgconf')
optdepends=(
  'gvfs: additional GIO Trash, mount, and administrator-location support'
  'ffmpeg: ffprobe-backed advanced video metadata'
)
options=('!lto')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('3a83a646d4cf131be1be61d9ea94e25089bc5935f224f6b03679a3b3ceadee8e')

build() {
  cd "$pkgname-$pkgver"
  cargo build --frozen --release -p floe-app --bin floe
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --frozen --workspace
}

package() {
  cd "$pkgname-$pkgver"
  DESTDIR="$pkgdir" PREFIX=/usr sh packaging/install.sh
}
